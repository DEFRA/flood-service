{
  "name": "flood-service",
  "version": "9.1.2",
  "description": "Flood risk service",
  "engines": {
    "node": "24.x"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "start:local": "npx nodemon --ext js,json,html,env -r dotenv/config index.js",
    "start:local:no-watch": "node -r dotenv/config index.js",
    "unit-test": "LOG_LEVEL=silent jest --coverage",
    "unit-test:no-coverage": "LOG_LEVEL=silent jest",
    "test": "npm run lint && npm run unit-test",
    "test:no-coverage": "npm run lint && npm run unit-test:no-coverage",
    "create-release-notes": "node release-docs/lib/create-release-notes.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@airbrake/node": "2.1.9",
    "@aws-sdk/client-s3": "3.1043.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.9",
    "hapi-pino": "13.0.0",
    "joi": "18.3.1",
    "nunjucks": "3.2.4",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-abstract-transport": "3.0.0",
    "pino-pretty": "13.1.3",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "4.1.0",
    "dotenv": "17.4.2",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "jest-extended": "7.0.0",
    "neostandard": "0.14.1",
    "nodemon": "3.1.14"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1",
      "@eslint/config-array": {
        "minimatch": "11.0.1"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "nodemon": {
      "minimatch": "11.0.1"
    }
  }
}
